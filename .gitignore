# ═══════════════════════════════════════════════════════════════
# Eleuther — Gitignore
# ═══════════════════════════════════════════════════════════════

# API Keys & Local Secrets
api-keys.env
.env
.env.*
*.key
*.pem

# Local OmniRoute & Backups
.omniroute/
.eleuther-backups/
*.bak

# Coding Agent Workspace Injectables (generated per-workspace)
.claude/
.opencode/
.codex/
AGENTS.md
CONVENTIONS.md
.aider.conf.yml

# Dependencies
node_modules/

# OS and Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs and Temp files
*.log
tmp/
temp/
