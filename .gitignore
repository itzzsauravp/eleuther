# ═══════════════════════════════════════════════════════════════
# OmniRoute Config — Gitignore
# ═══════════════════════════════════════════════════════════════

# API Keys — NEVER commit these!
api-keys.env
*.env
.env
.env.local
.env.*.local

# API Keys in any format
*api-key*
*apikey*
*API_KEY*

# Sensitive files
*.key
*.pem
*.p12
*.pfx
*.jks

# OmniRoute local config
.omniroute/
omniroute/

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Backup files
*.backup
*.bak
*.old
*-backup-*
*-bak-*
*-old-*

# Temp files
*.tmp
*.temp
*.log
tmp/
temp/

# Build files
dist/
build/
*.o
*.so
*.dylib

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Package files
*.tar.gz
*.rar
*.zip

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/
.env/

# JetBrains
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Local History
.history/

# Misc
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Optional npm dependencies
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build directories
dist/
build/

# Coverage
coverage/
.nyc_output/

# Output
output/
out/
