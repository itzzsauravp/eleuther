# ═══════════════════════════════════════════════════════════════
# OmniRoute API Keys — TEMPLATE
# ═══════════════════════════════════════════════════════════════
# Copy this to:
#   ~/.omniroute/api-keys.env      (macOS / Linux / WSL)
#   %USERPROFILE%\.omniroute\api-keys.env    (Windows)
#
# Only fill in the keys you have. Empty keys are safely skipped.
# Scripts check for non-empty values before registering.
# ──────────────────────────────────────────────────────────────
#
# ✅ = Saurav's active keys (working in this config)
# Copy the KEY portion, not the value!
#
# ─── Tier 1: Major Providers (biggest allocations) ─────────────

GEMINI_API_KEY=        # ✅ Google Gemini
                         # Get: https://aistudio.google.com/apikey
                         # Free: 1,500 req/day (Gemini 2.0 Flash)

GROQ_API_KEY=          # ✅ Groq
                         # Get: https://console.groq.com
                         # Free: 30 req/min (Llama 3.3 70B — blazing fast)

NVIDIA_API_KEY=        # ✅ NVIDIA NIM
                         # Get: https://build.nvidia.com
                         # Free: 1,000 credits/mo (Nemotron 340B)

CEREBRAS_API_KEY=      # ✅ Cerebras
                         # Get: https://cloud.cerebras.ai
                         # Free: Generous tier (Llama 3.1 70B — fastest inference)

SAMBANOVA_API_KEY=     # ✅ SambaNova
                         # Get: https://cloud.sambanova.ai
                         # Free: Generous tier (Llama 3.1 70B)

DEEPSEEK_API_KEY=      # ✅ DeepSeek
                         # Get: https://platform.deepseek.com
                         # Free: DeepSeek V3, Coder, Reasoner

MISTRAL_API_KEY=       # ✅ Mistral
                         # Get: https://console.mistral.ai
                         # Free: Mistral Large, Codestral

COHERE_API_KEY=        # ✅ Cohere
                         # Get: https://dashboard.cohere.com
                         # Free: Command R, Command R+ (great for agentic tasks)

HUGGINGFACE_API_KEY=  # ✅ HuggingFace
                         # Get: https://huggingface.co/settings/tokens
                         # Free: Access to 1000+ open models

DEEPINFRA_API_KEY=     # ✅ DeepInfra
                         # Get: https://deepinfra.com
                         # Free: Llama, Mistral, Qwen

# ─── Tier 2: Chinese & Noteable Providers ─────────────────────

SILICONFLOW_API_KEY=  # ✅ SiliconFlow (Qwen, Llama — China)
                         # Get: https://siliconflow.cn
                         # Free: Qwen 72B, Llama 70B

MODELSCOPE_API_KEY=    # ✅ ModelScope (Chinese models)
                         # Get: https://modelscope.cn
                         # Free: Qwen, MiniCPM,Yi

POLLINATIONS_API_KEY=  # ✅ Pollinations (open models)
                         # Get: https://pollinations.ai
                         # Free: No-key mode available too

CLOUDFLARE_AI_API_KEY= # ✅ Cloudflare Workers AI
                          # Get: https://developers.cloudflare.com/workers-ai
                          # Free: Built-in workers AI, some models free

# ─── Tier 3: Pass-Through Routers (one key → many models) ─────

OPENROUTER_API_KEY=   # ✅ OpenRouter (50+ FREE models via one key!)
                         # Get: https://openrouter.ai
                         # Free: Llama 3.1 70B, Qwen 72B, Gemini Flash Thinking
                         # ⭐ HIGHLY RECOMMENDED — single key, massive selection

# ─── Unused slots (blank = not configured) ────────────────────
